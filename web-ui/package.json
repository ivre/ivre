{
  "name": "ivre-web-ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "IVRE Web UI (React 19 + Vite + Tailwind 4 + shadcn/ui)",
  "license": "GPL-3.0-or-later",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
