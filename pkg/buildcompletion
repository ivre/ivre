# Regenerates bash_completion/ivre from the argparse parsers
# (ivre.cli:get_parser) using shtab. Requires the [completion] and
# [plots] extras (importing ivre.tools.plotdb needs matplotlib).
#
# The parsers reflect the configured DB backends and the installed
# optional dependencies (e.g. dbus-python adds a choice to the
# --graph options), so the output must be generated in a clean
# environment to match the CI regen check: no custom IVRE
# configuration and no extras beyond [completion] and [plots]. The
# canonical invocation is:
#
#     uv run --with-editable '.[completion,plots]' --no-project \
#         --python 3.13 ./pkg/buildcompletion

cd "$(dirname "$0")/.." || exit 255

for conf in /etc/ivre.conf /etc/ivre/ivre.conf /usr/local/etc/ivre.conf \
    /usr/local/etc/ivre/ivre.conf "$HOME/.ivre.conf" "$IVRE_CONF"; do
    if [ -n "$conf" ] && [ -f "$conf" ]; then
        printf 'WARNING: %s exists; the generated completions may differ from the CI regen check.\n' "$conf" >&2
    fi
done

tmp="bash_completion/.ivre.tmp"
if {
    printf '# Generated by pkg/buildcompletion -- do not edit by hand.\n'
    python -m shtab --shell=bash --error-unimportable --prog ivre ivre.cli.get_parser
} > "$tmp"; then
    mv "$tmp" bash_completion/ivre
else
    rm -f "$tmp"
    exit 1
fi
