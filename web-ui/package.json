    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-virtual": "^3.14.11",
    "@uiw/react-md-editor": "^4.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cytoscape": "^3.34.3",
    "lucide-react": "^1.43.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-cytoscapejs": "^2.0.0",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.3",
    "remark-gfm": "^4.0.1",
